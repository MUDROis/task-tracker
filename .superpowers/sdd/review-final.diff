).getTime(); +    } + +    function calendarDaysUntil(dueDateStr) { +        if (!dueDateStr) return null; +        var due = new Date(dueDateStr); +        if (isNaN(due.getTime())) return null; +        var now = new Date(); +        return Math.round((startOfDay(due) - startOfDay(now)) / DAY_MS); +    } + +    function deadlineStripClass(daysLeft) { +        if (daysLeft === null || typeof daysLeft === 'undefined') return 'strip-none'; +        if (daysLeft > 5) return 'strip-ok'; +        if (daysLeft >= 4) return 'strip-warn'; +        if (daysLeft >= 3) return 'strip-orange'; +        if (daysLeft >= 2) return 'strip-coral'; +        if (daysLeft >= 1) return 'strip-red'; +        return 'strip-overdue'; +    } + +    function isCompletedLate(completedAtStr, dueDateStr) { +        if (!completedAtStr || !dueDateStr) return false; +        var completed = new Date(completedAtStr); +        var due = new Date(dueDateStr); +        if (isNaN(completed.getTime()) || isNaN(due.getTime())) return false; +        return completed.getTime() > due.getTime(); +    } + +    function doneStripClass(completedAt, dueDate, completedLate) { +        if (completedLate) return 'strip-overdue'; +        if (completedAt) return 'strip-ok'; +        return deadlineStripClass(calendarDaysUntil(dueDate)); +    } + +    return { +        calendarDaysUntil: calendarDaysUntil, +        deadlineStripClass: deadlineStripClass, +        isCompletedLate: isCompletedLate, +        doneStripClass: doneStripClass +    }; +})); diff --git a/style.css b/style.css index e0941b7..865853a 100644 --- a/style.css +++ b/style.css @@ -360,29 +360,27 @@ body {  }    .task-card .task-delegate-arrow.arrow-delegated {      color: #3b82f6;  }    .task-card .task-delegate-arrow.arrow-received {      color: #ef4444;  }   -.task-card.priority-high { -    border-left-color: #22c55e; -} -.task-card.priority-medium { -    border-left-color: #3b82f6; -} -.task-card.priority-low { -    border-left-color: #94a3b8; 